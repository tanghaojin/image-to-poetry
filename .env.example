APP_NAME=见景寻诗 API
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

POSTGRES_PASSWORD=img2poetry
DATABASE_URL=postgresql+asyncpg://img2poetry:img2poetry@postgres:5432/img2poetry
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DAILY=100
RATE_LIMIT_TIMEZONE=Asia/Hong_Kong
FINGERPRINT_HASH_SECRET=replace-with-a-random-server-only-secret
REDIS_KEY_PREFIX=img2poetry

GOOGLE_AI_API_KEY=
BIG_MODEL_API_KEY=
VISION_MODEL_ORDER=gemini-3.7-flash,gemini-3.6-flash,glm-4.6v-flash,glm-4.1v-thinking-flash
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_EDGE=1600
IMAGE_JPEG_QUALITY=85
VISION_CONNECT_TIMEOUT=5
VISION_READ_TIMEOUT=20
VISION_TOTAL_TIMEOUT=45
